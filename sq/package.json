{
  "name": "synapse-quantum",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-ort.mjs",
    "dev": "vite --open",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "train:onnx": "python data-reservoir/training/train_heston_readout_onnx.py",
    "train:recorded": "python data-reservoir/training/train_heston_readout_onnx.py --csv"
  },
  "dependencies": {
    "onnxruntime-web": "^1.17.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.40",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
